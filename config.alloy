prometheus.exporter.unix "local_system" {
  procfs_path = coalesce(sys.env("ALLOY_PROCFS_PATH"), "/proc")
  sysfs_path  = coalesce(sys.env("ALLOY_SYSFS_PATH"), "/sys")
  rootfs_path = coalesce(sys.env("ALLOY_ROOTFS_PATH"), "/")
}

prometheus.exporter.cadvisor "docker_stats" {
  docker_host            = "unix:///var/run/docker.sock"
  store_container_labels = true
}

discovery.relabel "host_targets_conditional" {
  targets = prometheus.exporter.unix.local_system.targets

  rule {
    target_label = "__keep_host"
    replacement  = coalesce(sys.env("ALLOY_COLLECT_HOST"), "false")
  }

  rule {
    source_labels = ["__keep_host"]
    regex         = "true"
    action        = "keep"
  }
}

prometheus.scrape "metrics_scraper" {
  targets = concat(
    prometheus.exporter.cadvisor.docker_stats.targets,
    discovery.relabel.host_targets_conditional.output,
  )
  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.status_hub.input]
  }
}

prometheus.scrape "python_apps" {
  targets = [
    {"__address__" = "gdcheerioscom:8000", "job" = "gdcheerioscom"},
    {"__address__" = "gdcheeriosws:8000", "job" = "gdcheeriosws"},
    {"__address__" = "gdcheeriosstorage:8000", "job" = "gdcheeriosstorage"},
  ]
  scrape_interval = "15s"

  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.exporter.otlphttp "status_hub" {
  client {
    endpoint = "http://status:4318"
  }
}

prometheus.exporter.postgres "local_postgres" {
  data_source_names = [
    format("postgresql://%s:%s@psql:5432/gdcheeriosdb?sslmode=disable", sys.env("MONITOR_USER"), sys.env("MONITOR_PASSWORD")),
  ]

  enabled_collectors = ["stat_database", "database", "stat_statements"]
}

prometheus.scrape "postgres_metrics" {
  targets    = prometheus.exporter.postgres.local_postgres.targets
  forward_to = [prometheus.remote_write.local_lgtm.receiver]
}

prometheus.remote_write "local_lgtm" {
  endpoint {
    url = "http://status:9090/api/v1/write"
  }
}

discovery.docker "local_containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_name_mapping" {
  targets = discovery.docker.local_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service_name"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_name_mapping.output
  forward_to = [otelcol.receiver.loki.otel_converter.receiver]
}

otelcol.receiver.loki "otel_converter" {
  output {
    logs = [otelcol.processor.transform.promote_name.input]
  }
}

otelcol.processor.transform "promote_name" {
  error_mode = "ignore"
  log_statements {
    context = "log"
    statements = [
      `set(resource.attributes["service.name"], attributes["service_name"])`,
    ]
  }
  output {
    logs = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    logs = [otelcol.exporter.otlphttp.status_hub.input]
  }
}
