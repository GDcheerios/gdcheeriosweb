prometheus.exporter.unix "local_system" {
  procfs_path = coalesce(sys.env("ALLOY_PROCFS_PATH"), "/proc")
  sysfs_path  = coalesce(sys.env("ALLOY_SYSFS_PATH"), "/sys")
  rootfs_path = coalesce(sys.env("ALLOY_ROOTFS_PATH"), "/")
}

prometheus.exporter.cadvisor "docker_stats" {
  docker_host            = "unix:///var/run/docker.sock"
  store_container_labels = true
}

discovery.relabel "host_targets_conditional" {
  targets = prometheus.exporter.unix.local_system.targets

  rule {
    target_label = "__keep_host"
    replacement  = coalesce(sys.env("ALLOY_COLLECT_HOST"), "false")
  }

  rule {
    source_labels = ["__keep_host"]
    regex         = "true"
    action        = "keep"
  }
}

prometheus.scrape "metrics_scraper" {
  targets = concat(
    prometheus.exporter.cadvisor.docker_stats.targets,
    discovery.relabel.host_targets_conditional.output,
  )
  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.receiver.prometheus "default" {
  output {
    metrics = [otelcol.exporter.otlphttp.status_hub.input]
  }
}

prometheus.scrape "python_apps" {
  targets = [
    {"__address__" = "gdcheerioscom:8000", "job" = "gdcheerioscom"},
    {"__address__" = "gdcheeriosws:8765", "job" = "gdcheeriosws"},
  ]
  scrape_interval = "15s"
  
  forward_to = [otelcol.receiver.prometheus.default.receiver]
}

otelcol.exporter.otlphttp "status_hub" {
  client {
    endpoint = "http://status:4318"
  }
}
