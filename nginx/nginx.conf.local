events {}

stream {}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 80;
        server_name _;
        resolver 127.0.0.11 valid=30s;

        location / {
            set $backend_app "http://gdcheerioscom:8000";
            proxy_pass $backend_app;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /ws/ {
            set $backend_ws "http://gdcheeriosws:8765/";
            proxy_pass $backend_ws;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;

            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
        }

        location /status {
            return 301 /grafana/d/gd8pdt4/status?orgId=1&kiosk=tv;
        }

        location /grafana/ {
            proxy_pass http://status:3000;
            proxy_set_header Host $http_host;
        }

        location /alloy/ {
            proxy_pass http://alloy:12345/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        location /static/ {
            alias /static/;
        }
    }
}